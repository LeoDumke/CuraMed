    l.titulo,
    COUNT(e.id) AS quantidade_emprestimos

FROM livro l

INNER JOIN exemplar_livro ex
    ON l.id = ex.livro_id

INNER JOIN emprestimo e
    ON ex.id = e.exemplar_id

GROUP BY l.id, l.titulo

ORDER BY quantidade_emprestimos DESC;


