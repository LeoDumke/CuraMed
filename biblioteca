-- CRIAR VIEWS


-- VIEW 1:EMPRESTIMOS COMPLETOS

CREATE VIEW vw_emprestimos_completos AS

SELECT
    e.id AS emprestimo_id,
    u.nome AS usuario,
    l.titulo AS livro,
    ex.codigo AS codigo_exemplar,
    b.nome AS bibliotecario,
    e.data_emprestimo,
    e.data_devolucao,
    e.data_devolucao_real,
    e.status

FROM emprestimo e

INNER JOIN usuario u
    ON e.usuario_id = u.id

INNER JOIN exemplar_livro ex
    ON e.exemplar_id = ex.id

INNER JOIN livro l
    ON ex.livro_id = l.id

INNER JOIN bibliotecario b
    ON e.bibliotecario_id = b.id;


-- VIEW 2:LIVROS DISPONIVEIS

CREATE VIEW vw_livros_disponiveis AS

SELECT
    l.id AS livro_id,
    l.titulo,
    l.autor,
    l.categoria,
    ex.id AS exemplar_id,
    ex.codigo

FROM livro l

INNER JOIN exemplar_livro ex
    ON l.id = ex.livro_id

WHERE ex.status = 'Disponível';


-- VIEW 3:EMPRESTIMOS ATRASADOS

CREATE VIEW vw_emprestimos_atrasados AS

SELECT
    e.id AS emprestimo_id,
    u.nome AS usuario,
    l.titulo AS livro,
    e.data_emprestimo,
    e.data_devolucao,
    DATEDIFF(CURDATE(), e.data_devolucao)
        AS dias_atrasados

FROM emprestimo e

INNER JOIN usuario u
    ON e.usuario_id = u.id

INNER JOIN exemplar_livro ex
    ON e.exemplar_id = ex.id

INNER JOIN livro l
    ON ex.livro_id = l.id

WHERE e.status IN ('Ativo', 'Atrasado')
AND e.data_devolucao < CURDATE();

--  TRIGGERS

DELIMITER $$

-- TRIGGER 1: VERIFICAR DISPONIBILIDADE

CREATE TRIGGER trg_verificar_exemplar

BEFORE INSERT ON emprestimo

FOR EACH ROW
BEGIN

    DECLARE situacao VARCHAR(30);
    DECLARE quantidade INT;

    SELECT COUNT(*)
    INTO quantidade
    FROM exemplar_livro
    WHERE id = NEW.exemplar_id;

    IF quantidade = 0 THEN

        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Exemplar nao encontrado';

    END IF;

    SELECT status
    INTO situacao
    FROM exemplar_livro
    WHERE id = NEW.exemplar_id;

    IF situacao <> 'Disponível' THEN

        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT =
        'Exemplar indisponivel para emprestimo';

    END IF;

END$$


-- TRIGGER 2: ATUALIZAR STATUS DO EXEMPLAR

CREATE TRIGGER trg_atualizar_exemplar

AFTER INSERT ON emprestimo

FOR EACH ROW
BEGIN

    UPDATE exemplar_livro

    SET status = 'Emprestado'

    WHERE id = NEW.exemplar_id;

END$$


-- TRIGGER 3: ATUALIZAR STATUS NA DEVOLUCAO

CREATE TRIGGER trg_devolucao_exemplar

AFTER UPDATE ON emprestimo

FOR EACH ROW
BEGIN

    IF NEW.status = 'Devolvido'
       AND OLD.status <> 'Devolvido' THEN

        UPDATE exemplar_livro

        SET status = 'Disponível'

        WHERE id = NEW.exemplar_id;

    END IF;

END$$


-- TRIGGER 4: AUDITORIA DE NOVOS EMPRESTIMOS

CREATE TRIGGER trg_auditoria_emprestimo

AFTER INSERT ON emprestimo

FOR EACH ROW
BEGIN

    INSERT INTO auditoria
    (tabela, operacao, descricao)

    VALUES (
        'emprestimo',
        'INSERT',
        CONCAT(
            'Novo emprestimo registrado. ID: ',
            NEW.id
        )
    );

END$$


-- TRIGGER 5: AUDITORIA DE ALTERACOES

CREATE TRIGGER trg_auditoria_devolucao

AFTER UPDATE ON emprestimo

FOR EACH ROW
BEGIN

    INSERT INTO auditoria
    (tabela, operacao, descricao)

    VALUES (
        'emprestimo',
        'UPDATE',
        CONCAT(
            'Emprestimo ID ',
            NEW.id,
            ' alterado. Status anterior: ',
            OLD.status,
            '. Novo status: ',
            NEW.status
        )
    );

END$$

-- 12. STORED PROCEDURES

-- PROCEDURE 1: REALIZAR EMPRESTIMO

CREATE PROCEDURE realizar_emprestimo(

    IN p_usuario_id INT,
    IN p_exemplar_id INT,
    IN p_bibliotecario_id INT,
    IN p_data_devolucao DATE

)
BEGIN

    DECLARE situacao VARCHAR(30);

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        RESIGNAL;
    END;

    START TRANSACTION;

    SELECT status
    INTO situacao
    FROM exemplar_livro
    WHERE id = p_exemplar_id
    FOR UPDATE;

    IF situacao IS NULL OR situacao <> 'Disponível' THEN

        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Exemplar indisponivel';

    END IF;

    INSERT INTO emprestimo (
        usuario_id,
        exemplar_id,
        bibliotecario_id,
        data_emprestimo,
        data_devolucao,
        status
    )

    VALUES (
        p_usuario_id,
        p_exemplar_id,
        p_bibliotecario_id,
        CURDATE(),
        p_data_devolucao,
        'Ativo'
    );

    COMMIT;

END$$


-- PROCEDURE 2: REALIZAR DEVOLUCAO

CREATE PROCEDURE realizar_devolucao(

    IN p_emprestimo_id INT

)
BEGIN

    DECLARE situacao VARCHAR(30);

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        RESIGNAL;
    END;

    START TRANSACTION;

    SELECT status
    INTO situacao
    FROM emprestimo
    WHERE id = p_emprestimo_id
    FOR UPDATE;

    IF situacao IS NULL THEN

        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Emprestimo nao encontrado';

    END IF;

    IF situacao = 'Devolvido' THEN

        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Livro ja devolvido';

    END IF;

    UPDATE emprestimo

    SET
        status = 'Devolvido',
        data_devolucao_real = CURDATE()

    WHERE id = p_emprestimo_id;

    COMMIT;

END$$


