
-- SISTEMA DE GERENCIAMENTO DE BIBLIOTECA

CREATE DATABASE IF NOT EXISTS biblioteca;

USE biblioteca;

-- TABELA BIBLIOTECARIO

CREATE TABLE bibliotecario (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    email VARCHAR(100) NOT NULL UNIQUE
);
-- TABELA LIVRO

CREATE TABLE livro (
    id INT AUTO_INCREMENT PRIMARY KEY,
    titulo VARCHAR(150) NOT NULL,
    autor VARCHAR(100) NOT NULL,
    editora VARCHAR(100),
    categoria VARCHAR(80)
);

-- TABELA USUARIO

CREATE TABLE usuario (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    cpf VARCHAR(14) NOT NULL UNIQUE,
    email VARCHAR(100) NOT NULL UNIQUE,
    telefone VARCHAR(20)
);

-- TABELA EXEMPLAR_LIVRO

CREATE TABLE exemplar_livro (
    id INT AUTO_INCREMENT PRIMARY KEY,
    livro_id INT NOT NULL,
    codigo VARCHAR(30) NOT NULL UNIQUE,

    status ENUM(
        'Disponível',
        'Emprestado',
        'Em manutenção'
    ) DEFAULT 'Disponível',

    FOREIGN KEY (livro_id)
        REFERENCES livro(id)
);

-- TABELA EMPRESTIMO

CREATE TABLE emprestimo (
    id INT AUTO_INCREMENT PRIMARY KEY,

    usuario_id INT NOT NULL,
    exemplar_id INT NOT NULL,
    bibliotecario_id INT NOT NULL,

    data_emprestimo DATE NOT NULL,
    data_devolucao DATE NOT NULL,
    data_devolucao_real DATE,

    status ENUM(
        'Ativo',
        'Devolvido',
        'Atrasado'
    ) DEFAULT 'Ativo',

    FOREIGN KEY (usuario_id)
        REFERENCES usuario(id),

    FOREIGN KEY (exemplar_id)
        REFERENCES exemplar_livro(id),

    FOREIGN KEY (bibliotecario_id)
        REFERENCES bibliotecario(id),

    CONSTRAINT chk_datas_emprestimo
        CHECK (data_devolucao >= data_emprestimo)
);

-- TABELA DE AUDITORIA

CREATE TABLE auditoria (
    id INT AUTO_INCREMENT PRIMARY KEY,
    tabela VARCHAR(50) NOT NULL,
    operacao VARCHAR(50) NOT NULL,
    descricao TEXT,
    data_hora DATETIME DEFAULT CURRENT_TIMESTAMP
);

